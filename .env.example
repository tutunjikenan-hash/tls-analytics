# ---- required -------------------------------------------------------------------------------
# Postgres connection (Supabase: Project settings → Database → connection string, "session" mode)
DATABASE_URL=postgres://user:password@host:5432/tls
# require (verify certificate) | no-verify (TLS without verification) | disable (local only)
DATABASE_SSL=require
# Secret used to turn Roblox UserIds into pseudonymous player keys. 32+ random characters.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# NEVER change it after launch: every player would look new.
PLAYER_ID_PEPPER=
# Public URL of the dashboard (used for origin checks and the ingest URL shown in Settings)
APP_URL=https://analytics.example.com

# First start only (no shell on the host): creates this owner if there are no users yet.
# Remove both after the first sign-in.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=

# ---- optional -------------------------------------------------------------------------------
# Discord webhook for alerts and daily/weekly reports
DISCORD_WEBHOOK_URL=
# The experience's universe id, to fetch Roblox's public counts (visits, favorites, playing)
ROBLOX_UNIVERSE_ID=
# Session cookie lifetime
SESSION_TTL_HOURS=168
# Background jobs run on one instance (Postgres leader election); set false to opt an instance out
JOBS_ENABLED=true
# Which environments alerts watch (comma separated)
ALERT_ENVS=production
# Behind a proxy/load balancer that sets X-Forwarded-For (Railway, Fly, Render: true)
TRUST_PROXY=true
DATABASE_POOL_MAX=10
INGEST_RATE_PER_KEY_PER_MIN=60000
INGEST_RATE_PER_SERVER_PER_MIN=120
